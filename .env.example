# Never put secret/service-role keys in NEXT_PUBLIC variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# In production set this to the portal origin, e.g. https://portal.tomatosky.com
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Production host split. Leave BOTH unset for local development (single origin).
# When set, the public site is served from SITE_HOST and the employee portal
# from PORTAL_HOST; each host refuses the other's routes. Server-only (not public).
SITE_HOST=
PORTAL_HOST=
